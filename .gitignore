# Ambientes virtuais
.venv/
env/
venv/
ENV/

# Arquivos de ambiente e segredos (RF01, RF04, RF11, RF12)
.env
*.env
!.env.example

# Bytecode e caches do Python
__pycache__/
*.py[cod]
*$py.class
*.so
.pytest_cache/
.rf10-testes-locais/
.llm-diagnosticos/
.integracao-local/
pytest-cache-files-*/
.coverage
htmlcov/

# Logs e arquivos de sistema
*.log
.DS_Store
Thumbs.db

# Artefatos gerados pelo fluxo (preservando estrutura de pastas)
dados/processados/*
!dados/processados/.gitkeep
resultados/minutas/*
!resultados/minutas/.gitkeep
resultados/audios/*
!resultados/audios/.gitkeep
resultados/imagens/*
!resultados/imagens/.gitkeep
resultados/logs/*
!resultados/logs/.gitkeep
!resultados/logs/audit_trail.jsonl
prompts/experimento_*/
prompts/validacao_*/
scratch/
documentacao/relatorio_lgpd_execucao.json
