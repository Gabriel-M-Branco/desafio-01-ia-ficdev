# Configurações de API e Ambiente - Central Inteligente de Atendimento GOV.MT

# Token da Hugging Face (Inference Providers; pode haver cobrança)
# Obtenha em: https://huggingface.co/settings/tokens
HF_TOKEN=

# RF06: local (gratuito, CPU/int8, idioma pt) ou huggingface (sujeito a cobrança).
# Local requer faster-whisper e modelo small previamente baixado no cache.
# Nunca baixa modelos automaticamente; independe de HF_TOKEN e EXECUTION_MODE.
STT_PROVIDER=local

# RF07: sapi5 (Windows, local gratuito) ou edge-tts (opcional, requer internet).
TTS_PROVIDER=sapi5
TTS_LOCAL_VOICE=Microsoft Maria

# RF10: FLUX é o modelo; selecione provedor explícito, com acesso/créditos.
# EXECUTION_MODE=mock bloqueia geração real; não há fallback gráfico como IA.
IMAGE_PROVIDER=fal-ai
IMAGE_MODEL=black-forest-labs/FLUX.1-schnell
IMAGE_SEED=42
# Opcional: servidor próprio, local/remoto, com protocolo text-to-image HF e saída de imagem.
# Recebe JSON inputs/parameters e devolve PNG/JPEG; modelo já carregado no servidor.
# Não instala modelo nem inicia GPU. Vazio mantém Inference Providers.
IMAGE_ENDPOINT=
IMAGE_ENDPOINT_TOKEN=

# RF10 Cloudflare: selecione IMAGE_PROVIDER=cloudflare para utilizar estes campos.
# O plano/cota da conta determina eventual cobrança; nenhuma tentativa automática extra.
# FLUX Cloudflare recebe prompt/steps; IMAGE_SEED não é enviado a esse endpoint.
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_IMAGE_MODEL=@cf/black-forest-labs/flux-1-schnell

# Chave OpenRouter (Opcional - Fallback gratuito)
# Obtenha em: https://openrouter.ai/keys
OPENROUTER_API_KEY=

# Modo de Execução: 'auto' (usa API se houver chave; senão retorna indisponível), 'api' (força API) ou 'mock' (desabilita chamadas; não simula resultados)
EXECUTION_MODE=auto

# Servidor Web
HOST=0.0.0.0
PORT=8000
DEBUG=False

# OpenRouter é opcional e desativado por padrão; :free não garante disponibilidade.
OPENROUTER_ENABLED=false
OPENROUTER_MODEL=meta-llama/llama-3.3-70b-instruct:free
