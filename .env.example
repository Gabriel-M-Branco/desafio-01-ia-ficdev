# Configurações de API e Ambiente - Central Inteligente de Atendimento GOV.MT

# Token da Hugging Face (Inference API Serverless - Gratuito)
# Obtenha em: https://huggingface.co/settings/tokens
HF_TOKEN=

# Chave OpenRouter (Opcional - Fallback gratuito)
# Obtenha em: https://openrouter.ai/keys
OPENROUTER_API_KEY=

# Modo de Execução: 'auto' (usa API se houver chave, senão mock), 'api' (força API) ou 'mock' (simulação offline segura)
EXECUTION_MODE=auto

# Servidor Web
HOST=0.0.0.0
PORT=8000
DEBUG=False
